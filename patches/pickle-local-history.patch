diff --git a/packages/pickle/native/internal/core/chord_history_test.go b/packages/pickle/native/internal/core/chord_history_test.go
new file mode 100644
index 0000000..6b00f45
--- /dev/null
+++ b/packages/pickle/native/internal/core/chord_history_test.go
@@ -0,0 +1,40 @@
+package core
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/id"
+)
+
+func TestChordHistoryKeepsThreadReplies(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/_matrix/client/v3/rooms/!room:example/messages" {
+			_, _ = w.Write([]byte(`{"chunk":[{"event_id":"$reply","type":"m.room.message","sender":"@bob:example","origin_server_ts":1000,"content":{"msgtype":"m.text","body":"A reply that must remain visible","m.relates_to":{"rel_type":"m.thread","event_id":"$root","m.in_reply_to":{"event_id":"$root"}}}}],"end":"older"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"chunk":[]}`))
+	}))
+	defer server.Close()
+	core := New(nil)
+	core.client, _ = mautrix.NewClient(server.URL, id.UserID("@alice:example"), "local-test")
+	raw, err := core.handleFetchMessages(context.Background(), []byte(`{"roomId":"!room:example","limit":50}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result struct {
+		Messages []*MatrixMessageEvent `json:"messages"`
+		NextCursor string `json:"nextCursor"`
+	}
+	if err := json.Unmarshal(raw, &result); err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Messages) != 1 || result.Messages[0].ThreadRootEventID == nil || result.NextCursor != "older" {
+		t.Fatalf("thread reply or pagination lost: %s", raw)
+	}
+}
diff --git a/packages/pickle/native/internal/core/chord_media_test.go b/packages/pickle/native/internal/core/chord_media_test.go
new file mode 100644
index 0000000..2276d05
--- /dev/null
+++ b/packages/pickle/native/internal/core/chord_media_test.go
@@ -0,0 +1,34 @@
+package core
+
+import (
+	"context"
+	"maunium.net/go/mautrix"
+	"maunium.net/go/mautrix/id"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestChordMediaReplacementIncludesEncryptedEvents(t *testing.T) {
+	sawAllTypes := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/_matrix/client/v1/rooms/!room:example/relations/$pending/m.replace" {
+			sawAllTypes = true
+			_, _ = w.Write([]byte(`{"chunk":[{"event_id":"$media-edit","room_id":"!room:example","type":"m.room.message","sender":"@alice:example","origin_server_ts":2000,"content":{"msgtype":"m.image","body":"* photo.jpg","m.relates_to":{"rel_type":"m.replace","event_id":"$pending"},"m.new_content":{"msgtype":"m.image","body":"photo.jpg","url":"mxc://example/photo","info":{"mimetype":"image/jpeg","size":1234}}}}]}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"chunk":[]}`))
+	}))
+	defer server.Close()
+	client, _ := mautrix.NewClient(server.URL, id.UserID("@max:example"), "local-test")
+	core := New(nil)
+	original := &MatrixMessageEvent{MatrixRawEvent: MatrixRawEvent{EventID: "$pending"}, Body: "Waiting for media from phone", Msgtype: "m.notice"}
+	result := core.applyLatestReplacement(context.Background(), client, id.RoomID("!room:example"), original)
+	if !sawAllTypes {
+		t.Fatal("replacement query filtered out encrypted media edits")
+	}
+	if result == nil || len(result.Attachments) != 1 || result.Msgtype != "m.image" {
+		t.Fatalf("media replacement lost: %#v", result)
+	}
+}
